# Google Sheets RSVP — server-only, never exposed to the browser.
# Share the sheet with GOOGLE_CLIENT_EMAIL as an Editor.
GOOGLE_CLIENT_EMAIL=rsvp-writer@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=

# Optional: public URL for absolute link-preview tags when not hosted on Vercel.
NEXT_PUBLIC_SITE_URL=
