# Copy to .env.local for local development, and add the same variables in
# Vercel → Project → Settings → Environment Variables (Production + Preview).
# None of these use the NEXT_PUBLIC_ prefix, so they stay on the server.

# --- RSVP → Google Sheets ------------------------------------------------------
# 1. Google Cloud Console: enable the Google Sheets API, create a service
#    account, and add a JSON key for it.
# 2. Share the spreadsheet with the service account email as an Editor.

# "client_email" from the JSON key.
GOOGLE_CLIENT_EMAIL=rsvp-writer@your-project.iam.gserviceaccount.com

# "private_key" from the JSON key, kept on one line with literal \n sequences.
# In Vercel, paste the value without the surrounding quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"

# The long id in the sheet URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=your-spreadsheet-id

# Optional: tab to write to. Leave empty to use the first tab.
GOOGLE_SHEET_NAME=

# --- Link previews (WhatsApp, Telegram, Instagram) -----------------------------
# Optional: set when the invitation is served from a custom domain. Without it
# Vercel's production domain is used for the preview image URL.
NEXT_PUBLIC_SITE_URL=
